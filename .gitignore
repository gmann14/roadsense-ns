.DS_Store
.claude/

# Local secrets / credentials. Anything matching these patterns must
# never be committed; durable copies should live in ~/.context/secrets/
# (outside any worktree).
*.local
.env
.env.*
!.env.example
.cloudflare-token*
.cloudflare-config*
.railway-secrets*

# Xcode
DerivedData/
*.xcuserstate
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
ios/Config/*.secrets.xcconfig
ios/.swiftpm/
ios/build/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/

# Swift Package Manager
.build/

# Node / web
node_modules/
.next/
.open-next/
.vercel/
.wrangler/
coverage/
playwright-report/
test-results/
.lighthouseci/
tsconfig.tsbuildinfo

# Python tooling
__pycache__/
*.pyc

# Supabase local state
.supabase/
supabase/.temp/
supabase/.branches/
supabase/functions/.env

.railway-secrets.local
