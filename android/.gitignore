# A12-1: gradle wrapper jar/scripts are generated by `gradle wrapper`, not
# committed by hand. Run `gradle wrapper --gradle-version 8.10.2` once
# locally, then commit the resulting gradlew, gradlew.bat, and
# gradle/wrapper/gradle-wrapper.jar in a follow-up.
