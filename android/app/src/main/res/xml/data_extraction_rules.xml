<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ Auto Backup + Device Transfer rules. Same exclusions as
     backup_rules.xml: raw drive samples must not ride a cloud or device-to-
     device transfer channel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="roadsense.db" />
        <exclude domain="database" path="roadsense.db-shm" />
        <exclude domain="database" path="roadsense.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="roadsense.db" />
        <exclude domain="database" path="roadsense.db-shm" />
        <exclude domain="database" path="roadsense.db-wal" />
    </device-transfer>
</data-extraction-rules>
