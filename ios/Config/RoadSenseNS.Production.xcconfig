APP_ENV = PRODUCTION
APP_DISPLAY_NAME = RoadSense NS
API_BASE_URL = https:/$()/api.nsroadsense.ca
ROAD_SENSE_APP_BUNDLE_IDENTIFIER = ca.roadsense.ios
MAPBOX_ACCESS_TOKEN = pk.placeholder.production
SUPABASE_ANON_KEY = anon.placeholder.production
SENTRY_DSN =
ENABLE_SENTRY = NO
APP_GROUP_IDENTIFIER = group.ca.roadsense.ios
// Photo uploads stay off until the backend photo flow ships (R2 bucket +
// gateway handlers; see docs/reviews/2026-06-11-backend-prelaunch-review.md
// NEW-2 and backlog B130). The production gateway answers the photo routes
// with 503 photos_disabled until then. Flip to YES together with the server.
ENABLE_POTHOLE_PHOTOS = NO
ENABLE_MAP_FOLLOW_PUCK_ON_LAUNCH = NO
ENABLE_LIVE_MAPBOX_MAP = NO
ENABLE_ROAD_QUALITY_VECTOR_OVERLAY = YES

// Create RoadSenseNS.Production.secrets.xcconfig for local overrides.
// This file is optional and ignored by git.
#include? "RoadSenseNS.Production.secrets.xcconfig"
