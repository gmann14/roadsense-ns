APP_ENV = STAGING
APP_DISPLAY_NAME = RoadSense NS
API_BASE_URL = https:/$()/api.nsroadsense.ca
ROAD_SENSE_APP_BUNDLE_IDENTIFIER = ca.roadsense.ios
MAPBOX_ACCESS_TOKEN = pk.placeholder.staging
// The real public API key is never committed. Local Staging builds read it
// from RoadSenseNS.Staging.secrets.xcconfig (see Templates/); CI writes that
// file from the ROAD_SENSE_PUBLIC_API_KEY secret via fastlane.
SUPABASE_ANON_KEY = anon.placeholder.staging
SENTRY_DSN =
ENABLE_SENTRY = NO
APP_GROUP_IDENTIFIER = group.ca.roadsense.ios.staging
ENABLE_POTHOLE_PHOTOS = NO
ENABLE_MAP_FOLLOW_PUCK_ON_LAUNCH = NO
ENABLE_LIVE_MAPBOX_MAP = NO
ENABLE_ROAD_QUALITY_VECTOR_OVERLAY = YES

// Create RoadSenseNS.Staging.secrets.xcconfig for local overrides.
// This file is optional and ignored by git.
#include? "RoadSenseNS.Staging.secrets.xcconfig"
