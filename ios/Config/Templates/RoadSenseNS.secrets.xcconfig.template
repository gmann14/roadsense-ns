// Copy to Config/RoadSenseNS.<Local|Staging|Production>.secrets.xcconfig
// (git-ignored) and fill in real values. The committed base xcconfigs only
// carry placeholders; this file overrides them through `#include?`.
//
// CI never needs this file by hand: fastlane writes the Staging/Production
// secrets file from the ROAD_SENSE_PUBLIC_API_KEY and MAPBOX_ACCESS_TOKEN
// secrets before building.

MAPBOX_ACCESS_TOKEN = pk.__your_public_mapbox_token__
SUPABASE_ANON_KEY = __public_api_key_from_the_gateway__
SENTRY_DSN =

// Local device builds only:
// DEVELOPMENT_TEAM = <your Apple team ID>
// ROAD_SENSE_APP_BUNDLE_IDENTIFIER = <your unique bundle ID>
