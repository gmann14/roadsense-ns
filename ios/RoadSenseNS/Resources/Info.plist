<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>APP_ENV</key>
	<string>$(APP_ENV)</string>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>APP_GROUP_IDENTIFIER</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MAPBOX_ACCESS_TOKEN</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ca.roadsense.ios.nightly-cleanup</string>
		<string>ca.roadsense.ios.upload-drain</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>RoadSense NS uses the camera so you can photograph a pothole while you are stopped. A photo is taken only when you tap the shutter.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>RoadSense NS detects your drives automatically and records road-quality readings in the background, even when the app is closed. Readings inside your privacy zones never leave your phone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RoadSense NS uses your location to measure road quality while you drive.</string>
	<key>NSMotionUsageDescription</key>
	<string>RoadSense NS uses motion data to score road roughness and detect potholes.</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>ENABLE_SENTRY</key>
	<string>$(ENABLE_SENTRY)</string>
	<key>ENABLE_POTHOLE_PHOTOS</key>
	<string>$(ENABLE_POTHOLE_PHOTOS)</string>
	<key>ENABLE_MAP_FOLLOW_PUCK_ON_LAUNCH</key>
	<string>$(ENABLE_MAP_FOLLOW_PUCK_ON_LAUNCH)</string>
	<key>ENABLE_LIVE_MAPBOX_MAP</key>
	<string>$(ENABLE_LIVE_MAPBOX_MAP)</string>
	<key>ENABLE_ROAD_QUALITY_VECTOR_OVERLAY</key>
	<string>$(ENABLE_ROAD_QUALITY_VECTOR_OVERLAY)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
